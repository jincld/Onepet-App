<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".agregarempleadonew">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mediocirculoempleado"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <ImageView
            android:id="@+id/imageView38"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/figuranew"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <ImageView
            android:id="@+id/imageView40"
            android:layout_width="391dp"
            android:layout_height="445dp"
            android:layout_marginTop="384dp"
            android:src="@drawable/degabceleste"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView41"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mediocirculoempleadosdos"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.882"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.998" />

        <ImageView
            android:id="@+id/imageView39"
            android:layout_width="70dp"
            android:layout_height="59dp"
            android:src="@drawable/circuloempleados"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.158"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.757" />

        <ImageView
            android:id="@+id/imageView49"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/circuloempleados"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.062" />

        <ImageView
            android:id="@+id/imageView42"
            android:layout_width="399dp"
            android:layout_height="259dp"
            android:src="@drawable/imgperroempleados"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.997" />

        <TextView
            android:id="@+id/textViewempleado"
            android:layout_width="262dp"
            android:layout_height="59dp"
            android:text="Crear empleado"
            android:textAlignment="center"
            android:textColor="#383333"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.161" />

        <ScrollView
            android:layout_width="366dp"
            android:layout_height="279dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.413">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnCrearEmpleado"
                    android:layout_width="225dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bottomempleado"
                    android:text="Crear empleado"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    tools:layout_editor_absoluteX="6dp"
                    tools:layout_editor_absoluteY="150dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtNombreEmpleado"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="253dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="24dp"
                    android:drawableRight="@drawable/vectorpet"
                    android:hint="Nombre"
                    android:textSize="20sp"
                    app:boxBackgroundMode="outline"
                    app:layout_constraintBottom_toTopOf="@+id/txtCorreoEmpleado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.504"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingClass" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtCorreoEmpleado"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="253dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="24dp"
                    android:drawableRight="@drawable/vectorpet"
                    android:hint="Correo electrónico"
                    android:textSize="20sp"
                    app:boxBackgroundMode="outline"
                    app:layout_constraintBottom_toTopOf="@+id/txtContraEmpleado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingClass" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtContraEmpleado"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="253dp"
                    android:layout_height="56dp"
                    android:drawableRight="@drawable/vectorpet"
                    android:hint="Contraseña"
                    android:textSize="20sp"
                    app:boxBackgroundMode="outline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.495"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingClass"
                    tools:layout_editor_absoluteY="146dp" />

                <Button
                    android:id="@+id/button2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="300dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
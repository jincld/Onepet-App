<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".agregarempleadodv">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txtNombreEmpleado"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="200dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorpet"
        android:hint="Nombre"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txtCorreoEmpleado"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="280dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorpet"
        android:hint="Correo electrónico"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txtContraEmpleado"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="360dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorpet"
        android:hint="Contraseña"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />


    <Button
        android:id="@+id/btnCrearEmpleado"
        android:layout_width="225dp"
        android:layout_height="48dp"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="590dp"
        android:background="@drawable/bottomempleado"
        android:text="Crear empleado"
        android:textAlignment="center"
        android:textSize="16sp"
        app:backgroundTint="@null" />

    <ImageView
        android:id="@+id/imgempleados"
        android:layout_width="wrap_content"
        android:layout_height="113dp"
        android:src="@drawable/mediocirculoempleado" />

    <ImageView
        android:id="@+id/imgcircleempleados"
        android:layout_width="220dp"
        android:layout_height="174dp"
        android:layout_marginLeft="130dp"
        android:layout_marginTop="700dp"
        android:src="@drawable/mediocirculoempleadosdos" />

    <ImageView
        android:id="@+id/imgcircleempleatres"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="665dp"
        android:src="@drawable/circuloempleados" />

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="431dp"
        android:layout_height="478dp"
        android:layout_marginTop="390dp"
        android:src="@drawable/degcelesteinf" />

    <ImageView
        android:id="@+id/imgcircleempleacuatro"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:layout_marginLeft="160dp"
        android:layout_marginTop="45dp"
        android:rotation="-72"
        android:src="@drawable/circuloempleados" />

    <ImageView
        android:id="@+id/imgdogempleado"
        android:layout_width="439dp"
        android:layout_height="331dp"
        android:layout_marginTop="590dp"
        android:layout_marginRight="80dp"
        android:src="@drawable/imgperroempleados" />

    <ImageView
        android:id="@+id/imgfiguraempleado"
        android:layout_width="344dp"
        android:layout_height="144dp"
        android:layout_marginLeft="200dp"
        android:layout_marginTop="1dp"
        android:rotation="-8"
        android:src="@drawable/figuraempleados" />


    <TextView
        android:id="@+id/textViewempleado"
        android:layout_width="262dp"
        android:layout_height="59dp"
        android:layout_marginLeft="75dp"
        android:layout_marginTop="125dp"
        android:text="Crear empleado"
        android:textAlignment="center"
        android:textColor="#383333"
        android:textSize="34sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnRolEmpleado"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="440dp"
        android:layout_marginRight="40dp"
        android:hint="Rol"
        android:textSize="0sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <Spinner
        android:id="@+id/spnEtiquetaEmpleado"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="520dp"
        android:layout_marginRight="40dp"
        android:hint="Etiqueta"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

</FrameLayout>
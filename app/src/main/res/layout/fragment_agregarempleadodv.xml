<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".agregarempleadodv">

    <ImageView
        android:id="@+id/imgempleados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mediocirculoempleado" />

    <ImageView
        android:id="@+id/imageView27"
        android:layout_width="220dp"
        android:layout_height="174dp"
        android:layout_marginLeft="130dp"
        android:layout_marginTop="700dp"
        android:src="@drawable/mediocirculoempleadosdos" />

    <ImageView
        android:id="@+id/imageView30"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="665dp"
        android:src="@drawable/circuloempleados" />

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="431dp"
        android:layout_height="478dp"
        android:layout_marginTop="390dp"
        android:src="@drawable/degcelesteinf" />

    <ImageView
        android:id="@+id/imageView32"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:layout_marginLeft="160dp"
        android:layout_marginTop="45dp"
        android:rotation="-72"
        android:src="@drawable/circuloempleados" />

    <ImageView
        android:id="@+id/imageView33"
        android:layout_width="439dp"
        android:layout_height="331dp"
        android:layout_marginTop="590dp"
        android:layout_marginRight="80dp"
        android:src="@drawable/imgperroempleados" />

    <ImageView
        android:id="@+id/imageView34"
        android:layout_width="344dp"
        android:layout_height="144dp"
        android:layout_marginLeft="200dp"
        android:layout_marginTop="1dp"
        android:rotation="-8"
        android:src="@drawable/figuraempleados" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="262dp"
        android:layout_height="66dp"
        android:layout_marginLeft="75dp"
        android:layout_marginTop="125dp"
        android:text="Crear empleado"
        android:textAlignment="center"
        android:textColor="#383333"
        android:textSize="34sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="200dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorpet"
        android:hint="Nombre"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText2"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="280dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorpet"
        android:hint="Correo electrónico"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText3"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="360dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorpet"
        android:hint="Contraseña"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText4"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="440dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorspinner"
        android:hint="Rol"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText5"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="520dp"
        android:layout_marginRight="40dp"
        android:drawableRight="@drawable/vectorspinner"
        android:hint="Etiqueta"
        android:textSize="20sp"
        app:boxBackgroundMode="outline"
        tools:ignore="MissingClass" />

    <Button
        android:layout_width="243dp"
        android:layout_height="48dp"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="590dp"
        android:background="@drawable/bottomempleado"
        android:text="Registrar empleado"
        android:textAlignment="center"
        android:textSize="16sp"
        app:backgroundTint="@null" />

</FrameLayout>
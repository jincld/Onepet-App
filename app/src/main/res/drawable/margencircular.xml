<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item android:bottom="1dp">
                <shape>
                    <solid android:color="#000" />
                    <corners
                        android:radius="20dp" />
                    <padding
                        android:left="2dp"
                        android:right="2dp"
                        android:top="2dp"
                        android:bottom="3dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape>
                    <solid android:color="#F8F7F7" />
                    <corners
                        android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>